[Unit]
Description=Akashic release request

[Service]
ExecStart=/opt/akashic-publisher/current/python/bin/python -I -B /opt/akashic-publisher/current/source/scripts/akashic_release/authority.py serve
StandardInput=socket
StandardOutput=journal
StandardError=journal
WorkingDirectory=/
Environment=PATH=/usr/bin:/bin HOME=/var/lib/akashic-publisher
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/akashic-publisher
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=30
